---
import type { L } from '../data/site';
import T from './T.astro';

interface Props { id: string; label: L; title: L }
const { id, label, title } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl scroll-mt-20 px-4 py-16 sm:px-6 sm:py-24">
  <div class="reveal">
    <p class="font-mono text-xs uppercase tracking-[0.18em]" style="color: var(--accent)">
      <T t={label} />
    </p>
    <div class="rule mt-2 h-px w-12" style="background: var(--accent)"></div>
    <h2 data-parallax class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">
      <T t={title} />
    </h2>
  </div>
  <div class="mt-10"><slot /></div>
</section>
