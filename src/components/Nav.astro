---
import { person, sections } from '../data/site';
import T from './T.astro';

const items = [
  { t: sections.work.label, href: '#work' },
  { t: sections.skills.label, href: '#skills' },
  { t: sections.path.label, href: '#path' },
  { t: sections.about.label, href: '#about' },
  { t: sections.contact.label, href: '#contact' },
];

const initials = person.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<header
  class="sticky top-0 z-40 backdrop-blur-md"
  style="background: color-mix(in srgb, var(--bg) 82%, transparent); border-bottom: 1px solid var(--line)"
>
  <nav class="mx-auto flex max-w-5xl items-center gap-2.5 px-4 py-4 sm:gap-6 sm:px-6">
    <a href="#top" class="font-mono text-sm font-medium tracking-tight">{initials}</a>

    <ul class="nav-links ml-auto flex min-w-0 flex-1 items-center justify-end gap-3 overflow-x-auto text-xs sm:gap-6 sm:text-sm">
      {
        items.map((s) => (
          <li class="shrink-0">
            <a href={s.href} class="transition-opacity hover:opacity-60" style="color: var(--muted)">
              <T t={s.t} />
            </a>
          </li>
        ))
      }
    </ul>

    <button
      id="lang-toggle"
      type="button"
      aria-label="Switch language / Changer de langue"
      class="lang-toggle shrink-0 rounded-md px-2 py-1.5 font-mono text-[11px] transition-colors"
      style="border: 1px solid var(--line)"
    >
      <span class="en-label on">EN</span><span style="color: var(--line)">/</span><span
        class="fr-label off">FR</span
      >
    </button>

    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle colour theme"
      class="shrink-0 rounded-md px-2 py-1.5 text-sm transition-colors"
      style="border: 1px solid var(--line)"
    >
      <span aria-hidden="true">◑</span>
    </button>
  </nav>
</header>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const dark =
      root.dataset.theme === 'dark' ||
      (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.lang === 'fr' ? 'en' : 'fr';
    root.dataset.lang = next;
    root.lang = next;
    try {
      localStorage.setItem('lang', next);
    } catch {}
  });
</script>
