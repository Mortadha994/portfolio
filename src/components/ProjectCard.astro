---
import type { Project } from '../data/site';

interface Props { project: Project; index: number }
const { project, index } = Astro.props;
const slug = project.name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<article
  id={slug}
  class="lift reveal scroll-mt-24 overflow-hidden rounded-2xl"
  style={`--i: ${index}; border: 1px solid var(--line); background: var(--card)`}
>
  <div class="p-6 sm:p-9">
    <!-- Heading row -->
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <h3 class="text-2xl font-semibold tracking-tight">{project.name}</h3>
      {
        project.featured && (
          <span
            class="rounded-full px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.14em]"
            style="background: var(--accent-soft); color: var(--accent)"
          >
            Featured
          </span>
        )
      }
      <span class="ml-auto font-mono text-xs" style="color: var(--muted)">
        {project.kind} · {project.year}
      </span>
    </div>

    <p class="mt-4 max-w-3xl text-base leading-relaxed sm:text-lg">{project.blurb}</p>

    <!-- The problem, set apart -->
    <blockquote
      class="mt-7 max-w-3xl rounded-r-lg py-2 pl-5 text-sm leading-relaxed"
      style="border-left: 2px solid var(--accent); color: var(--muted)"
    >
      {project.problem}
    </blockquote>

    <!-- Detail, two up on desktop -->
    <div class="mt-8 grid gap-x-10 gap-y-7 sm:grid-cols-2">
      {
        project.detail.map((d) => (
          <div>
            <h4 class="text-sm font-semibold tracking-tight">{d.heading}</h4>
            <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted)">
              {d.body}
            </p>
          </div>
        ))
      }
    </div>

    <!-- Stack -->
    <ul data-chips class="mt-9 flex flex-wrap gap-2">
      {
        project.stack.map((s) => (
          <li
            class="chip rounded-md px-2 py-1 font-mono text-[11px]"
            style="border: 1px solid var(--line); color: var(--muted)"
          >
            {s}
          </li>
        ))
      }
    </ul>

    {
      (project.href || project.repo) && (
        <div class="mt-7 flex flex-wrap gap-5 text-sm">
          {project.href && (
            <a href={project.href} class="ul-grow" style="color: var(--accent)">
              Live site →
            </a>
          )}
          {project.repo && (
            <a href={project.repo} class="ul-grow" style="color: var(--accent)">
              Source →
            </a>
          )}
        </div>
      )
    }
  </div>

  <!-- Screenshot strip: scrolls sideways, snaps, full-bleed within the card -->
  {
    project.shots.length > 0 && (
      <div class="pb-7" style="border-top: 1px solid var(--line)">
        <div class="flex items-baseline justify-between px-6 pt-6 sm:px-9">
          <p class="font-mono text-[10px] uppercase tracking-[0.14em]" style="color: var(--muted)">
            {project.shots.length} screens
          </p>
          <p class="font-mono text-[10px]" style="color: var(--muted)">
            scroll →
          </p>
        </div>

        <ul class="strip mt-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-3 sm:px-9">
          {project.shots.map((shot) => (
            <li class="shot w-[min(84vw,30rem)] shrink-0 snap-start">
              <div class="overflow-hidden rounded-lg" style="border: 1px solid var(--line)">
                <img
                  src={shot.src}
                  alt={shot.alt}
                  loading="lazy"
                  decoding="async"
                  class="block h-auto w-full"
                />
              </div>
              <p class="mt-2.5 text-xs" style="color: var(--muted)">
                {shot.caption}
              </p>
            </li>
          ))}
        </ul>

        {project.note && (
          <p class="px-6 pt-2 text-[11px] italic sm:px-9" style="color: var(--muted)">
            {project.note}
          </p>
        )}
      </div>
    )
  }
</article>
