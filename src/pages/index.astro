---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import T from '../components/T.astro';
import {
  person,
  projects,
  skills,
  about,
  links,
  sections,
  path,
  languages,
  ui,
} from '../data/site';

const year = new Date().getFullYear();

// Must match the slug ProjectCard puts on each <article>.
const slug = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<Base>
  <Nav />
  <main id="main">
    <Hero />

    <Section id="work" label={sections.work.label} title={sections.work.title}>
      <ul class="reveal mb-10 flex flex-wrap gap-2">
        {
          projects.map((p) => (
            <li>
              <a
                href={'#' + slug(p.name)}
                class="index-chip inline-flex items-baseline gap-2 rounded-full px-3.5 py-1.5 text-sm"
                style="border: 1px solid var(--line); background: var(--card)"
              >
                <span>{p.name}</span>
                <span class="font-mono text-[10px]" style="color: var(--muted)">
                  {p.year}
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="space-y-8">
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </Section>

    <Section id="skills" label={sections.skills.label} title={sections.skills.title}>
      <div class="grid gap-5 sm:grid-cols-2">
        {
          skills.map((g, i) => (
            <div
              class="lift reveal rounded-xl p-5"
              style={`--i: ${i}; border: 1px solid var(--line); background: var(--card)`}
            >
              <h3 class="font-mono text-xs uppercase tracking-[0.15em]" style="color: var(--accent)">
                <T t={g.group} />
              </h3>
              <ul data-chips class="mt-4 flex flex-wrap gap-2">
                {g.items.map((item) => (
                  <li
                    class="chip rounded-md px-2 py-1 text-xs"
                    style="border: 1px solid var(--line); color: var(--muted)"
                  >
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Section>

    <Section id="path" label={sections.path.label} title={sections.path.title}>
      <ol class="space-y-0">
        {
          path.map((e, i) => (
            <li
              class="reveal grid gap-1 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6"
              style={`--i: ${i}; border-top: 1px solid var(--line)`}
            >
              <p class="font-mono text-xs" style="color: var(--accent)">
                <T t={e.when} />
              </p>
              <div>
                <h3 class="text-base font-semibold tracking-tight">
                  <T t={e.what} />
                </h3>
                <p class="mt-0.5 text-sm" style="color: var(--muted)">
                  {e.where}
                </p>
                <p class="mt-2 text-sm leading-relaxed" style="color: var(--muted)">
                  <T t={e.detail} />
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="reveal mt-10">
        <h3 class="font-mono text-xs uppercase tracking-[0.15em]" style="color: var(--accent)">
          <T t={ui.langsTitle} />
        </h3>
        <ul class="mt-3 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          {
            languages.map((l) => (
              <li>
                <T t={l.name} />
                <span style="color: var(--muted)">
                  {' — '}
                  <T t={l.level} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </Section>

    <Section id="about" label={sections.about.label} title={sections.about.title}>
      <div class="max-w-2xl space-y-4 text-base leading-relaxed">
        {
          about.map((p, i) => (
            <p class="reveal" style={`--i: ${i}`}>
              <T t={p} />
            </p>
          ))
        }
      </div>
    </Section>

    <Section id="contact" label={sections.contact.label} title={sections.contact.title}>
      <div class="reveal max-w-2xl">
        <p class="text-base leading-relaxed">
          <T t={ui.contactLead} />
        </p>
        <a
          href={`mailto:${person.email}`}
          class="lift mt-7 inline-block rounded-md px-5 py-3 text-sm font-medium"
          style="background: var(--accent); color: var(--bg)"
        >
          {person.email}
        </a>
      </div>
    </Section>
  </main>

  <footer class="mx-auto max-w-5xl px-4 py-10 sm:px-6" style="border-top: 1px solid var(--line)">
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm" style="color: var(--muted)">
      <span>© {year} {person.name}</span>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="ul-grow">
                <T t={l.label} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </footer>
</Base>
